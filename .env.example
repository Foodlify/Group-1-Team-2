# Copy this file to .env and fill in your own values
# Command: cp .env.example .env

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=foodlify
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodlify"

# Stripe
STRIPE_SECRET_KEY=""

# JWT Secrets (generate your own using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
RESET_TOKEN_SECRET=""

# Token Expiration
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server
PORT=3000

# Email (Gmail App Password required — used to send OTP / password-reset emails)
EMAIL_USER=""
EMAIL_PASS=""
