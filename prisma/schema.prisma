generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  password           String
  phone              String
  passwordChangedAt  DateTime?
  role               Role       @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())

  customer Customer?
  owner    Owner?

  refreshTokens       RefreshToken[]
  otpRequests         OtpRequest[]
  otpAuditLogs        OtpAuditLog[]
  passwordResetTokens PasswordResetToken[]
}

model Customer {
  id           Int           @id @default(autoincrement())
  userId       String           @unique
  user         User          @relation(fields: [userId], references: [id])
  carts        Cart[]
  addresses    Address[]
  order        Order[]
  transactions Transaction[]
    createdAt DateTime @default(now())
}

model Owner {
  id Int @id @default(autoincrement())
  userId String @unique
  user  User @relation(fields:[userId] , references:[id])
  restaurants Restaurant[]
  createdAt DateTime @default(now())
}

enum OtpChannel {
  EMAIL
  SMS
  APP
}

enum OtpPurpose {
  PASSWORD_RESET
  LOGIN
  TWO_FACTOR
  EMAIL_VERIFICATION
}

enum OtpStatus {
  PENDING
  USED
  EXPIRED
}

enum OtpEvent {
  SENT
  VERIFIED
  FAILED
  EXPIRED
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  deviceInfo String?
  ipAddress  String?
}

model OtpRequest {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel      OtpChannel
  purpose      OtpPurpose
  otpHash      String
  expiresAt    DateTime
  attemptCount Int        @default(0)
  maxAttempts  Int        @default(5)
  status       OtpStatus  @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpAuditLog {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel   OtpChannel
  event     OtpEvent
  ipAddress String?
  userAgent String?
  status    AuditStatus

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String     @unique
  purpose   OtpPurpose @default(PASSWORD_RESET)
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

model Restaurant {
  id Int @id @default(autoincrement())
  name String
  ownerId Int

  menus  Menu[]
  carts  Cart[]
  orders Order[]

  owner Owner @relation(fields:[ownerId], references:[id])
}

model Menu {
  id           Int @id @default(autoincrement())
  restaurantId Int

  isDeleted Boolean @default(false)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems  MenuItem[]
}

model MenuItem {
  id       Int     @id @default(autoincrement())
  menuId   Int
  itemName String
  price    Decimal @db.Decimal(10, 2)
  stock    Int     @default(0)

  isDeleted Boolean  @default(false)

  menu       Menu        @relation(fields: [menuId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
}

enum CartStatus {
  ACTIVE
  LOCKED
  COMPLETED
  UNLOCKED
}

model Cart {
  id           Int        @id @default(autoincrement())
  customerId   Int
  restaurantId Int
  status       CartStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  customer   Customer   @relation(fields: [customerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  cartItems CartItem[]
}

model CartItem {
  id         Int @id @default(autoincrement())
  cartId     Int
  menuItemId Int
  quantity   Int @default(1)

  cart     Cart     @relation(fields: [cartId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([cartId, menuItemId])
}

model Address {
  id          Int     @id @default(autoincrement())
  customerId  Int
  addressLine String
  city        String
  government  String
  postalCode  String?

  customer Customer @relation(fields: [customerId], references: [id])
  orders   Order[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id Int @id @default(autoincrement())

  customerId   Int
  restaurantId Int
  addressId    Int

  phone String
  notes String?

  status OrderStatus @default(PENDING)

  totalPrice Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)

  paidAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())

  customer   Customer   @relation(fields: [customerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  address    Address    @relation(fields: [addressId], references: [id])

  orderItems  OrderItem[]
  transaction Transaction?
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  itemName   String
  price      Decimal @db.Decimal(10, 2)
  quantity   Int
  itemTotal  Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

enum PaymentMethod {
  CASH
  CARD
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Transaction {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique
  customerId    Int
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  shippingFee   Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  currency      String        @default("EGP")
  createdAt     DateTime      @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  details TransactionDetails?
  audit   TransactionAudit[]
}

model TransactionDetails {
  id                    Int               @id @default(autoincrement())
  transactionId         Int               @unique
  provider              String? // "Stripe" , "PayMob"
  providerTransactionId String?           @unique
  status                TransactionStatus @default(PENDING)
  amount                Decimal           @db.Decimal(10, 2)
  details               Json? // raw response from gateway

  transaction Transaction @relation(fields: [transactionId], references: [id])
}

model TransactionAudit {
  id            Int           @id @default(autoincrement())
  transactionId Int
  oldStatus     PaymentStatus
  newStatus     PaymentStatus
  note          String?
  changedAt     DateTime      @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
}
